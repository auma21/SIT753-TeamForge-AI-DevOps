{
  "name": "sit753-teamforge-ai-devops",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",

    "test": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand --coverage=false",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand --coverage=false",
    "test:ci": "cross-env NODE_ENV=test jest --runInBand --coverage --ci",    

    "lint": "eslint src tests scripts",
    "quality": "npm run lint && npm run test:ci",
    
    "sonar": "sonar-scanner",

    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/check-secrets.js",
    "security": "npm run security:secrets && npm run security:audit",

    "smoke": "node scripts/smoke-test.js",
    "smoke:staging": "cross-env SMOKE_BASE_URL=http://localhost:3001 node scripts/smoke-test.js",
    "smoke:production": "cross-env SMOKE_BASE_URL=http://localhost:3000 node scripts/smoke-test.js"
  },
  "keywords": [],
  "author": "Tunde Ajayi",
  "license": "ISC",
  "description": "TeamForge AI - An explainable AI-assisted platform for Capstone team formation",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "sonar-scanner": "^3.1.0",
    "supertest": "^7.3.0"
  }
}
